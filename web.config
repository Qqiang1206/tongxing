<?xml version="1.0" encoding="UTF-8"?>
<!--
  tongxing · IIS 站点根配置
  ===========================================================================
  · /api/* 、/admin/* 反向代理到本机 Node CMS（127.0.0.1:8204）—— 后台在线可用靠它
  · 不对外暴露仓库内部（server/、data/schema/、_backups/ 等）
  · 保留原有：Gzip、静态缓存、旧链接重定向
  依赖：IIS 装 URL Rewrite + ARR，并开启 ARR 代理（详见部署文档）。
  与 bc.sztxgk.com（另一个项目，端口 8203）同机共存，互不影响。
-->
<configuration>
  <system.webServer>
    <!-- 启用 Gzip 压缩 -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <httpCompression>
      <staticTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <remove mimeType="*/*" />
      </staticTypes>
    </httpCompression>

    <!--
      安全响应头（IIS 直接托管静态文件，不走 Node，必须在这一层也下发一份）。
      注意：/api 与 /admin 由 ARR 反代到 Node，Node 同样会下发这些头，
      两层取值保持一致，重复设置不会冲突（值相同）。
    -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <add name="Content-Security-Policy" value="default-src 'self'; img-src 'self' data: blob: https://webapi.amap.com https://*.amap.com https://*.autonavi.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://webapi.amap.com https://*.amap.com https://*.autonavi.com; style-src 'self' 'unsafe-inline' https://webapi.amap.com https://*.amap.com https://*.autonavi.com; font-src 'self' data: https://webapi.amap.com https://*.amap.com https://*.autonavi.com; connect-src 'self' https://webapi.amap.com https://*.amap.com https://*.autonavi.com; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" />
        <!-- HTTPS 正式启用后（证书就绪）再放开下行 HSTS：
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" /> -->
      </customHeaders>
    </httpProtocol>

    <rewrite>
      <rules>
        <!-- ── 后端反代：API 与后台（需 URL Rewrite + ARR + 开启代理） ── -->
        <rule name="api-proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8204/api/{R:1}" />
        </rule>
        <rule name="admin-proxy" stopProcessing="true">
          <match url="^admin/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8204/admin/{R:1}" />
        </rule>
        <rule name="admin-slash" stopProcessing="true">
          <match url="^admin$" />
          <action type="Redirect" url="/admin/" redirectType="Found" />
        </rule>

        <!-- ── 不对外暴露仓库内部 ── -->
        <rule name="deny-server" stopProcessing="true"><match url="^server/" /><action type="AbortRequest" /></rule>
        <rule name="deny-node_modules" stopProcessing="true"><match url="^node_modules/" /><action type="AbortRequest" /></rule>
        <rule name="deny-backups" stopProcessing="true"><match url="^_backups/" /><action type="AbortRequest" /></rule>
        <rule name="deny-unused-images" stopProcessing="true"><match url="^_unused-images/" /><action type="AbortRequest" /></rule>
        <rule name="deny-scripts" stopProcessing="true"><match url="^scripts/" /><action type="AbortRequest" /></rule>
        <rule name="deny-docs" stopProcessing="true"><match url="^docs/" /><action type="AbortRequest" /></rule>
        <rule name="deny-nginx" stopProcessing="true"><match url="^nginx/" /><action type="AbortRequest" /></rule>
        <rule name="deny-templates" stopProcessing="true"><match url="^templates/" /><action type="AbortRequest" /></rule>
        <rule name="deny-output" stopProcessing="true"><match url="^output/" /><action type="AbortRequest" /></rule>
        <rule name="deny-data-schema" stopProcessing="true"><match url="^data/schema/" /><action type="AbortRequest" /></rule>
        <rule name="deny-upload-originals" stopProcessing="true"><match url="^assets/images/uploads/_originals/" /><action type="AbortRequest" /></rule>
        <rule name="deny-hidden" stopProcessing="true"><match url="(^|/)\.(?!well-known)" /><action type="AbortRequest" /></rule>
        <rule name="deny-configs" stopProcessing="true">
          <match url="^(package\.json|package-lock\.json|nginx\.conf|tailwind\.config\.js|README\.md|DESIGN\.md)$" />
          <action type="AbortRequest" />
        </rule>

        <!-- ── 旧链接重定向（保留原样） ── -->
        <rule name="Legacy EN suffix" stopProcessing="true">
          <match url="^(.+)-en\.html$" />
          <action type="Redirect" url="/en/{R:1}.html" redirectType="Permanent" />
        </rule>
        <rule name="Legacy RU suffix" stopProcessing="true">
          <match url="^(.+)-ru\.html$" />
          <action type="Redirect" url="/ru/{R:1}.html" redirectType="Permanent" />
        </rule>
        <rule name="Legacy product ZH" stopProcessing="true">
          <match url="^product-(\d+)\.html$" />
          <action type="Redirect" url="/product-detail.html?id={R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Legacy product EN" stopProcessing="true">
          <match url="^product-(\d+)-en\.html$" />
          <action type="Redirect" url="/en/product-detail.html?id={R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Legacy product RU" stopProcessing="true">
          <match url="^product-(\d+)-ru\.html$" />
          <action type="Redirect" url="/ru/product-detail.html?id={R:1}" redirectType="Permanent" />
        </rule>
      </rules>

      <!--
        html / js 必须每次校验。
        上面 <staticContent> 的 clientCache 给静态文件设了 365 天缓存，
        不改的话改版后访客端会一直拿到旧页面（表现为"改了没生效"）。
        这里对 .html/.js 覆盖成 no-cache；图片、字体、CSS 仍走长缓存。
      -->
      <outboundRules>
        <rule name="NoCacheHtmlAndJs" preCondition="IsHtmlOrJs">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-cache" />
        </rule>
        <preConditions>
          <preCondition name="IsHtmlOrJs">
            <add input="{REQUEST_URI}" pattern="\.(html|js)(\?|$)" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".txt" />
      <mimeMap fileExtension=".txt" mimeType="text/plain" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml" />
      <!-- 自托管字体 MIME（缺了字体加载不出来） -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <!-- 静态资源缓存一年 -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
