# ── Line-ending policy ──────────────────────────────────────────────────────
# Store LF in the repo; check out LF everywhere (Windows copy included).
# This kills the CRLF↔LF phantom diffs that were flagging every file as
# "modified" when the Windows (H:\) working copy got CRLF line endings.
* text=auto eol=lf

# ── Binary assets — never normalize ─────────────────────────────────────────
# Extensions actually present in the repo:
*.webp  binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.woff2 binary
# Forward-looking (currently gitignored or absent, but harmless to declare):
*.ico   binary
*.woff  binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp4   binary
*.webm  binary
*.mov   binary
*.mp3   binary
*.wav   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.7z    binary
*.db           binary
*.db-journal   binary
*.db-wal       binary
*.db-shm       binary
