{
  "name": "txam-website",
  "version": "2.0.0",
  "private": true,
  "description": "TXAM corporate site — static front + JSON data layer",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "generate-data-js": "node scripts/generate-data-js.js",
    "generate-landings": "node scripts/generate-solution-landings.js",
    "landings:check": "node scripts/generate-solution-landings.js --check",
    "validate": "node scripts/validate-data.js",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/pre-push",
    "translation:snapshot-baseline": "node server/scripts/seed-translation-snapshot.js",
    "test:translation": "node --test server/tests/*.test.js",
    "translation:restore-main-page-copy": "node server/scripts/restore-main-page-copy.js",
    "sync-product-i18n": "node scripts/sync-product-i18n.js",
    "sync-catalog-i18n": "node scripts/sync-catalog-i18n.js",
    "backup-data": "node scripts/backup-data.js",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "build": "node scripts/generate-data-js.js && node scripts/generate-solution-landings.js && node scripts/generate-sitemap.js && node scripts/build.js",
    "build:check": "node scripts/generate-solution-landings.js --check && node scripts/validate-data.js",
    "build:css": "tailwindcss -c tailwind.config.js -i assets/css/tailwind.src.css -o assets/css/tailwind.min.css --minify",
    "server:import": "npm run import --prefix server",
    "server:dev": "npm run dev --prefix server",
    "sync:static": "npm run sync:static --prefix server",
    "regression": "node scripts/regression-check.js",
    "optimize-static-images": "node scripts/optimize-static-images.mjs",
    "logo-mask": "node scripts/png-to-svg-mask.mjs assets/images/brand/logo.png assets/images/brand/logo-mask.svg"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
