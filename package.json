{
  "name": "txam-website",
  "version": "2.0.0",
  "private": true,
  "description": "TXAM corporate site — static front + JSON data layer",
    "scripts": {
      "extract-data": "node scripts/extract-content-data.js",
      "restructure": "node scripts/restructure-site.js",
      "generate-data-js": "node scripts/generate-data-js.js",
    "fill-catalog-slugs": "node scripts/fill-catalog-slugs.mjs",
    "fix-data-issues": "node scripts/fix-data-issues.mjs",
    "fix-seo-tags": "node scripts/fix-seo-tags.mjs",
    "fix-solutions-filterkey": "node scripts/fix-solutions-filterkey.mjs",
    "fix-audit-html": "node scripts/fix-audit-html.mjs",
    "fix-detail-pages": "node scripts/fix-detail-pages.mjs",
    "validate": "node scripts/validate-data.js",
    "sync-product-i18n": "node scripts/sync-product-i18n.js",
    "sync-catalog-i18n": "node scripts/sync-catalog-i18n.js",
    "backup-data": "node scripts/backup-data.js",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "patch-list-pages": "node scripts/patch-list-pages.js",
    "patch-phase3": "node scripts/patch-phase3.js",
    "ensure-data-js": "node scripts/ensure-data-js-scripts.js",
    "build": "node scripts/generate-data-js.js && node scripts/generate-sitemap.js && node scripts/build.js",
    "server:import": "npm run import --prefix server",
    "server:dev": "npm run dev --prefix server",
    "regression": "node scripts/regression-check.js",
    "patch-front-perf": "node scripts/patch-front-performance.mjs",
    "patch-list-page-meta": "node scripts/patch-list-page-meta.js",
    "optimize-static-images": "node scripts/optimize-static-images.mjs"
  }
}