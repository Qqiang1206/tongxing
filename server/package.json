{
  "name": "txam-server",
  "version": "0.1.0",
  "private": true,
  "description": "TXAM CMS read API — zh source language, en/ru via translation pipeline",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "sharp": "^0.34.5"
  },
  "scripts": {
    "dev": "node src/index.js",
    "import": "node scripts/import-from-json.js",
    "import:reset": "node scripts/import-from-json.js --reset",
    "import:media": "node scripts/import-site-images-to-media.js",
    "migrate:uploads": "node scripts/migrate-upload-variants.js",
    "setup": "node scripts/import-from-json.js",
    "sync:static": "node scripts/sync-static-from-db.js",
    "repair:i18n": "node scripts/repair-i18n-copies.mjs",
    "repair:i18n:check": "node scripts/repair-i18n-copies.mjs --check"
  }
}
