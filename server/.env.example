PORT=8204
# Local/dev: 0.0.0.0. Production behind nginx: 127.0.0.1
HOST=0.0.0.0
PUBLIC_CACHE_TTL_MS=45000
# Max JSON body for admin API (bytes). Align with nginx client_max_body_size.
MAX_BODY_BYTES=12582912
# Login brute-force limit per IP per minute
# ADMIN_LOGIN_MAX_ATTEMPTS=8
# Public analytics hit limit per IP per minute
# ANALYTICS_MAX_HITS_PER_MIN=120
# Page-view analytics: master switch + Host header ignore list
# (default ignores localhost/127.0.0.1/::1 so dev/QA traffic stays out)
# ANALYTICS_ENABLED=1
# ANALYTICS_IGNORE_HOSTS=localhost,127.0.0.1,::1
# Analytics day boundary timezone (default Asia/Shanghai)
# ANALYTICS_TZ=Asia/Shanghai
# Required for /admin/ — never commit the real value.
# On first boot, this creates a super_admin account (see ADMIN_USERNAME).
# Only seeds the FIRST super_admin on a fresh database; never valid for login afterwards.
ADMIN_PASSWORD=change-me
# Optional: username for the bootstrap super_admin (default: admin)
# ADMIN_USERNAME=admin
# Optional: display name for the bootstrap super_admin (default: 超级管理员)
# ADMIN_DISPLAY_NAME=超级管理员
# Session TTL in hours (default: 8)
# ADMIN_SESSION_HOURS=8
# Production: set to your site origin instead of *
CORS_ORIGIN=*
# SQLite database (relative to server/)
SQLITE_PATH=./data/txam.db
# Also write data/*.json + *.js after DB writes (static / file:// fallback). Set 0 to disable.
SYNC_JSON_ON_WRITE=1
# Audit log retention (days). Set 0 to disable pruning.
# AUDIT_RETENTION_DAYS=90

# Translation (OpenAI-compatible). Without API key → echo dry-run ([EN]/[RU] prefixes).
# Automatic echo writes are disabled by default to protect en/ru content.
# For isolated local tests only: TRANSLATION_ALLOW_ECHO_WRITE=1
# DeepSeek (recommended):
TRANSLATION_PROVIDER=deepseek
TRANSLATION_API_KEY=sk-your-deepseek-key
# TRANSLATION_BASE_URL=https://api.deepseek.com
# TRANSLATION_MODEL=deepseek-v4-flash
# Or set DEEPSEEK_API_KEY=... instead of TRANSLATION_API_KEY.
#
# OpenAI:
# TRANSLATION_PROVIDER=openai
# TRANSLATION_API_KEY=sk-...
# TRANSLATION_BASE_URL=https://api.openai.com/v1
# TRANSLATION_MODEL=gpt-4o-mini
