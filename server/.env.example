PORT=3000
# Local/dev: 0.0.0.0. Production behind nginx: 127.0.0.1
HOST=0.0.0.0
PUBLIC_CACHE_TTL_MS=45000
# Required for /admin/ — never commit the real value
ADMIN_PASSWORD=change-me
# Optional default operator name when X-Admin-Actor is missing
# ADMIN_ACTOR=管理员
# Production: set to your site origin instead of *
CORS_ORIGIN=*
# SQLite database (relative to server/)
SQLITE_PATH=./data/txam.db
# Also write data/*.json + *.js after DB writes (static / file:// fallback). Set 0 to disable.
SYNC_JSON_ON_WRITE=1
# Audit log retention (days). Set 0 to disable pruning.
# AUDIT_RETENTION_DAYS=90

# Translation (OpenAI-compatible). Without API key → echo dry-run ([EN]/[RU] prefixes).
# DeepSeek (recommended):
TRANSLATION_PROVIDER=deepseek
TRANSLATION_API_KEY=sk-your-deepseek-key
# TRANSLATION_BASE_URL=https://api.deepseek.com
# TRANSLATION_MODEL=deepseek-v4-flash
# Or set DEEPSEEK_API_KEY=... instead of TRANSLATION_API_KEY.
#
# OpenAI:
# TRANSLATION_PROVIDER=openai
# TRANSLATION_API_KEY=sk-...
# TRANSLATION_BASE_URL=https://api.openai.com/v1
# TRANSLATION_MODEL=gpt-4o-mini
